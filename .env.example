# Copy to .env to change these. Every value has a working local default,
# so the README quick start needs no .env at all.

# Peppers the hashes of API keys. Change it for anything but a local demo.
CUBOID_KEY_PEPPER=dev-pepper-change-me

# Demo mode lists reproducible keys at /api/demo/keys and enables the drills.
# Turn it off for anything but a local demo; keys then come from `cuboid keys`.
CUBOID_DEMO_MODE=true
CUBOID_DEMO_KEY_SEED=cuboid-demo

# Browser origins allowed besides Cuboid's own UI, comma separated.
CUBOID_CORS_ORIGINS=

# Data tier for `docker compose --profile seed run --rm seed`: dev, small or main.
SEED_TIER=small
